{
  "name": "social-media-scheduler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:performance": "vitest run src/__tests__/performance",
    "test:integration": "vitest run src/__tests__/integration",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node scripts/migrate.js run",
    "db:show": "node scripts/migrate.js show",
    "db:test": "node scripts/test-db.js",
    "db:validate": "node scripts/validate-schema.js",
    "storage:setup": "node scripts/setup-storage.js",
    "build:production": "./scripts/build-production.sh",
    "deploy": "./scripts/deploy.sh",
    "monitor": "./scripts/monitor.sh",
    "docker:build": "docker build -t social-media-scheduler .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.production social-media-scheduler",
    "health:check": "curl -f http://localhost:3000/api/health",
    "ready:check": "curl -f http://localhost:3000/api/ready"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.38.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "moment": "^2.30.1",
    "next": "14.2.5",
    "node-cron": "^4.2.1",
    "react": "^18",
    "react-big-calendar": "^1.19.4",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18",
    "uuid": "^11.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-big-calendar": "^1.16.2",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^5.0.1",
    "dotenv": "^16.3.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "jsdom": "^26.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
