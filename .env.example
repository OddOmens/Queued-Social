# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# App Configuration
VITE_APP_URL=http://localhost:3000

# Scheduler Configuration
# Set to 'false' to disable browser-based scheduler (recommended for production)
# When disabled, posts are processed by Supabase cron job only
VITE_ENABLE_BROWSER_SCHEDULER=false

# Platform API Configuration (for OAuth redirects)
VITE_THREADS_CLIENT_ID=your-threads-client-id
VITE_LINKEDIN_CLIENT_ID=your-linkedin-client-id

# Instagram API Configuration (Direct Login - no Facebook Page required)
VITE_INSTAGRAM_CLIENT_ID=your-instagram-app-id
INSTAGRAM_CLIENT_SECRET=your-instagram-app-secret