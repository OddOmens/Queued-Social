############################################################
# Self-Hosted Supabase — Environment Variables
# Copy this to .env.supabase and fill in all values.
# Generate JWT keys by running:  node scripts/generate-supabase-keys.js
############################################################

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_PASSWORD=your-super-secret-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── JWT (generate with scripts/generate-supabase-keys.js) ─
# Must be at least 40 characters
JWT_SECRET=your-super-secret-jwt-token-with-at-least-40-chars
JWT_EXPIRY=3600

# These are full JWT tokens (not just random strings)
# Run: node scripts/generate-supabase-keys.js  to generate them
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_GENERATED_ANON_KEY
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_GENERATED_SERVICE_ROLE_KEY

# ── URLs ──────────────────────────────────────────────────
# The public URL of your Supabase API (via Kong)
# If behind a reverse proxy (e.g. Coolify/Caddy), use your domain:
API_EXTERNAL_URL=https://supabase.yourdomain.com

# Your app's public URL (for auth redirects)
SITE_URL=https://schedule.yourdomain.com

# Comma-separated list of allowed OAuth redirect URLs
ADDITIONAL_REDIRECT_URLS=https://schedule.yourdomain.com,https://schedule.yourdomain.com/auth/callback

# ── Kong ports (change if 8000/8443 are in use) ───────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ── Studio ────────────────────────────────────────────────
STUDIO_PORT=3001
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=your-studio-dashboard-password
STUDIO_DEFAULT_ORGANIZATION=Queued Social
STUDIO_DEFAULT_PROJECT=queued-social

# ── Auth ──────────────────────────────────────────────────
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false

# SMTP — use any mail provider (Resend, Postmark, SES, etc.)
SMTP_ADMIN_EMAIL=admin@yourdomain.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_SENDER_NAME=Queued Social

# Google OAuth (same credentials as your Supabase cloud project)
ENABLE_GOOGLE_SIGNUP=true
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Storage (Cloudflare R2 — reuse your existing bucket) ──
STORAGE_BACKEND=s3
STORAGE_S3_BUCKET=your-r2-bucket-name
STORAGE_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY=your-r2-access-key-id
STORAGE_S3_SECRET_KEY=your-r2-secret-access-key

# ── Realtime ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SECRET_KEY_BASE=your-secret-key-base-64-chars-min
REALTIME_SECRET=supabaserealtime

# ── Analytics / Logs ──────────────────────────────────────
LOGFLARE_API_KEY=your-logflare-api-key

# ── App secrets (forwarded to Edge Functions) ─────────────
VITE_CREDENTIAL_ENCRYPTION_KEY=your-32-byte-encryption-key

THREADS_CLIENT_ID=your-threads-client-id
THREADS_CLIENT_SECRET=your-threads-client-secret
THREADS_REDIRECT_URI=https://schedule.yourdomain.com/auth/threads/callback

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=https://schedule.yourdomain.com/auth/linkedin/callback

INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
INSTAGRAM_REDIRECT_URI=https://schedule.yourdomain.com/auth/instagram/callback

STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRICE_ID_PRO=price_your-stripe-price-id

# Secret shared between pg_cron and edge functions (any random string)
SCHEDULER_SECRET=your-scheduler-secret-random-string

# ── Network (for app ↔ supabase communication) ────────────
# Name of the app's docker network (check with: docker network ls)
APP_NETWORK_NAME=queued-social_app_network

# Functions URL (used by storage webhook)
FUNCTIONS_URL=http://functions:9000
