# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Platform API Keys
THREADS_CLIENT_ID=your_threads_client_id_here
THREADS_CLIENT_SECRET=your_threads_client_secret_here
THREADS_REDIRECT_URI=https://schedule.oddomens.com/api/auth/threads/callback
THREADS_WEBHOOK_VERIFY_TOKEN=your_secure_webhook_verify_token_here

# NextAuth Configuration
NEXTAUTH_URL=https://schedule.oddomens.com
NEXTAUTH_SECRET=your-super-secret-jwt-secret-here

# CORS and Security
CORS_ORIGIN=https://schedule.oddomens.com
ALLOWED_HOSTS=https://schedule.oddomens.com

# File Upload Configuration
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,video/quicktime
MAX_FILE_SIZE=10485760

# Job Configuration
ENABLE_CRON_JOBS=true
ENABLE_METRICS=true
JOB_CONCURRENCY=5
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY=5000

# Logging and Performance
LOG_LEVEL=info
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# Build optimization
NODE_OPTIONS="--max-old-space-size=2048"
NEXT_TELEMETRY_DISABLED=1

# Reduce build memory usage
CI=true
NODE_ENV=production

# Disable source maps in production to save memory
GENERATE_SOURCEMAP=false